<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PokeCalc" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vermelho</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorSecondary">@color/vermelho_escuro</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorError">@color/erro</item>
        <!-- Android 15: não desenhar por baixo da barra de status/navegação -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Splash Screen API: mostra o ícone enquanto a sessão é verificada. -->
    <style name="Theme.PokeCalc.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fundo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PokeCalc</item>
    </style>

    <style name="Texto.Titulo" parent="TextAppearance.Material3.TitleLarge" />
    <style name="Texto.Destaque" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
