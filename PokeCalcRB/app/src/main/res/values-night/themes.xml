<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Modo escuro: vermelho claro para manter o contraste sobre fundo escuro. -->
    <style name="Theme.PokeCalc" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vermelho_claro</item>
        <item name="colorOnPrimary">@color/vermelho_escuro</item>
        <item name="colorSecondary">@color/vermelho_claro</item>
        <item name="colorOnSecondary">@color/vermelho_escuro</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
