<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PokéAPI (só declarar; não é permissão de tempo de execução) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foto de perfil pela câmera: pedida em tempo de execução -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Notificações: pedida em tempo de execução no Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A câmera é opcional: sem ela o usuário usa a galeria -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".PokeCalcApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PokeCalc">

        <!-- Tela de abertura (Splash Screen API) + tela principal -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PokeCalc.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.CadastroActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Entrega à câmera um endereço seguro (content://) para gravar a foto na pasta interna -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
